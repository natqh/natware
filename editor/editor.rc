// editor.exe's icon and version resource. natware reads ProductVersion to know which editor is
// installed. The page (HTML, JS, CSS, font) comes from ..\natware\src\features\editor\editor_assets.rc.
#include <winresrc.h>
#include "version.h"

// The "n", the same icon as natware.exe. main.cpp also puts it on the editor window.
1 ICON "..\\natware\\src\\natware.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EDITOR_VERSION_RC
 PRODUCTVERSION EDITOR_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "natware"
            VALUE "FileDescription", "natware editor"
            VALUE "FileVersion", EDITOR_VERSION
            VALUE "InternalName", "editor"
            VALUE "OriginalFilename", "editor.exe"
            VALUE "ProductName", "natware"
            VALUE "ProductVersion", EDITOR_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// natware.exe's icon and version resource (Explorer's Details tab; the version itself is in version.h).
#include <winresrc.h>
#include "version.h"

// The "n" (logo.png, every size in natware.ico). The first icon is the exe's icon; main.cpp also
// puts it on the launcher window for the taskbar.
1 ICON "natware.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NATWARE_VERSION_RC
 PRODUCTVERSION NATWARE_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "natware"
            VALUE "FileDescription", "natware"
            VALUE "FileVersion", NATWARE_VERSION
            VALUE "InternalName", "natware"
            VALUE "OriginalFilename", "natware.exe"
            VALUE "ProductName", "natware"
            VALUE "ProductVersion", NATWARE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
